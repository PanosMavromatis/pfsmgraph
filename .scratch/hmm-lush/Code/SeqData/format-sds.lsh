
(de format-sds (basename)
  (setq basename (concat basename ".sds/"))
  (let* ((current-symbol ())
         (alphabet '(begin end))
         (alphabet-size 2)
         (current-sequence ())
         (current-sequence-size 2)
         (all-sequences ())
         (size 0)
         (seq-sizes ())
         (seq-size-max 2))
    (reading (concat basename "_raw_data")
      (while (<> (skip-char) "\e")
        (setq current-symbol (read))
        (if current-symbol
            (progn
              (unless (member current-symbol alphabet)
                (add-to alphabet current-symbol)
                (incr alphabet-size))
              (add-to current-sequence
                      (member-pos current-symbol alphabet))
              (incr current-sequence-size))
          (add-to all-sequences current-sequence)
          (add-to seq-sizes current-sequence-size)
          (incr size)
          (when (> current-sequence-size seq-size-max)
            (setq seq-size-max current-sequence-size))
          (setq current-sequence ())
          (setq current-sequence-size 2))))
    (writing (open-write (concat basename "_alphabet_size"))
      (print alphabet-size))
    (writing (open-write (concat basename "_alphabet"))
      (for (i-symb 0 (1- alphabet-size))
	   (printf "%d\t%l\n" i-symb (nth i-symb alphabet))))
    (writing (open-write (concat basename "_size"))
      (print size))
    (writing (open-write (concat basename "_seq_size_max"))
      (print seq-size-max))
    (writing (open-write (concat basename "_seq_sizes"))
      (for (i-seq 0 (1- size))
	   (printf "%d\t%d\n" i-seq (nth i-seq seq-sizes))))
    (for (i-seq 0 (1- size))
         (writing (open-write (concat basename (str i-seq) ".seq"))
           (setq current-sequence (nth i-seq all-sequences))
           (print 0)
	   (each ((current-symbol-n current-sequence))
	     (print current-symbol-n))
           (print 1)))
    ()))



(dhc-make
 ()
 *factor*
 *min-split-trials*
 *split-trials-per-state-p*
 
 (hmm-trainer
  update-params
  update-data-p
  update-viterbi-path
  update-data
  update-approx-init-state-p
  update-approx-transition-p
  update-approx-output-p
  update-approx-p
  update-data-dl
  update-model-dl
  update-total-dl
  update-dl
  update-trainer
  update-all
  
  run-add
  run-converge
  run-converge-with-update
  ))


